# Ignore node_modules in both frontend and backend
/node_modules/
/blockchain/node_modules/
/client/node_modules/
/client/.next/

# Ignore environment variables
/.env
/backend/.env

# Ignore build/output directories
dist/
build/
out/

# Ignore logs
*.log

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore IDE-specific files
.vscode/
.idea/

# Ignore npm/yarn cache
.npm
.yarn
.yarn-cache

# Ignore package-lock files (optional, depending on your workflow)
package-lock.json
yarn.lock

# Ignore Hardhat cache
/blockchain/cache/
/blockchain/artifacts/

# TypeChain files
/blockchain/typechain
/blockchain/typechain-types

# solidity-coverage files
/blockchain/coverage
/blockchain/coverage.json

# Hardhat Ignition default folder for deployments against a local node
/blockchain/ignition/deployments/chain-31337
